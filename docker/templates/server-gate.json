{
  // New server, HK role: REALITY gate behind an nginx SNI splitter.
  // Listens on 127.0.0.1:${GATE_PORT}; nginx (see docker-compose) forwards the
  // matching SNI here and probes to the decoy site. The ai-user identity may
  // ONLY reach MS:${MS_PORT}; everything else is blocked. HK forwards the
  // client's tunneled TCP straight to MS via freedom (the inner REALITY
  // handshake is end-to-end between client and MS, transparent to HK).
  //
  // NOTE: rebuilt from the documented live structure. Verify field-by-field
  // against the running HK /opt/hk-gate/xray/config.json before a production
  // cutover; `xray run -test` only proves structural validity.
  "log": { "loglevel": "warning", "access": "/var/log/v2ray/access.log", "error": "/var/log/v2ray/error.log" },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": ${GATE_PORT},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "${GATE_AI_UUID}", "flow": "xtls-rprx-vision", "email": "ai-user" } ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "${GATE_DEST}",
          "serverNames": [ "${GATE_SERVERNAME}" ],
          "privateKey": "${GATE_PRIVATEKEY}",
          "shortIds": [ "${GATE_SHORTID}" ]
        }
      },
      "tag": "gate"
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "settings": {}, "tag": "direct" },
    { "protocol": "blackhole", "settings": {}, "tag": "block" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "user": [ "ai-user" ], "ip": [ "${MS_ADDRESS}" ], "port": ${MS_PORT}, "outboundTag": "direct" },
      { "type": "field", "network": "tcp,udp", "outboundTag": "block" }
    ]
  }
}
