{
  // Legacy server: VMess inbound (LA / MS legacy :8744). Same image, different .env
  // yields either the LA or the MS legacy endpoint.
  "log": { "loglevel": "warning", "access": "/var/log/v2ray/access.log", "error": "/var/log/v2ray/error.log" },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": ${LISTEN_PORT},
      "protocol": "vmess",
      "settings": {
        "clients": [ { "id": "${SERVER_UUID}", "alterId": ${SERVER_ALTERID} } ]
      },
      "streamSettings": { "network": "tcp", "tcpSettings": { "header": { "type": "http" } } },
      "tag": "in"
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "settings": {}, "tag": "direct" },
    { "protocol": "blackhole", "settings": {}, "tag": "block" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "ip": [ "geoip:private" ], "outboundTag": "block" }
    ]
  }
}
