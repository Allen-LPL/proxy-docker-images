# New server, MS role (REALITY terminal :17443).
# Copy to .env and fill EVERY REPLACE_ME from vault. Never commit real values.
# Generate the keypair with:  docker run --rm --entrypoint xray liupengliang/infra:server-exit x25519
EXIT_PORT=17443
EXIT_CLIENT_UUID=REPLACE_ME
EXIT_DEST=REPLACE_ME
EXIT_SERVERNAME=REPLACE_ME
EXIT_PRIVATEKEY=REPLACE_ME
EXIT_SHORTID=REPLACE_ME
