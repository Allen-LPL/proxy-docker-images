# New server, exit role (REALITY terminal). Copy to .env and fill EVERY
# REPLACE_ME from your secret store. Never commit real values.
# Generate the keypair with:
#   docker run --rm --entrypoint xray "$IMAGE_REPO":server-exit x25519

# Registry namespace for the images (overrides the compose default), e.g. youruser/infra
IMAGE_REPO=youruser/infra

EXIT_PORT=17443
EXIT_CLIENT_UUID=REPLACE_ME
EXIT_DEST=REPLACE_ME
EXIT_SERVERNAME=REPLACE_ME
EXIT_PRIVATEKEY=REPLACE_ME
EXIT_SHORTID=REPLACE_ME
