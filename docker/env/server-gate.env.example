# New server, gate role (REALITY gate behind an nginx SNI splitter). Copy to
# .env and fill EVERY REPLACE_ME from your secret store. Never commit real values.
# Generate the keypair with:
#   docker run --rm --entrypoint xray "$IMAGE_REPO":server-gate x25519

# Registry namespace for the images (overrides the compose default), e.g. youruser/infra
IMAGE_REPO=youruser/infra

GATE_PORT=8443
GATE_AI_UUID=REPLACE_ME
GATE_DEST=REPLACE_ME
GATE_SERVERNAME=REPLACE_ME
GATE_PRIVATEKEY=REPLACE_ME
GATE_SHORTID=REPLACE_ME

# Where the ai-user identity is allowed to reach (the exit); everything else blocked.
MS_ADDRESS=REPLACE_ME
MS_PORT=17443

# nginx SNI splitter (see docker-compose): decoy upstream for non-matching probes.
DECOY_UPSTREAM=REPLACE_ME
