# Legacy client (single global VMess exit). Copy to .env and fill EVERY
# REPLACE_ME from your secret store. Never commit real values.

# Registry namespace for the images (overrides the compose default), e.g. youruser/infra
IMAGE_REPO=youruser/infra

SOCKS_PORT=10808
HTTP_PORT=10809
LA_ADDRESS=REPLACE_ME
LA_PORT=8744
LA_UUID=REPLACE_ME
LA_ALTERID=64
