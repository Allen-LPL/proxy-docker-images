# New client (Claude -> MS-AI double-layer, ChatGPT/default -> LA).
# Copy to .env and fill EVERY REPLACE_ME from vault. Real endpoints, camouflage
# serverNames, UUIDs and keys must NEVER be committed in plaintext.
SOCKS_PORT=10808
HTTP_PORT=10809

# Default exit: LA legacy VMess
LA_ADDRESS=REPLACE_ME
LA_PORT=8744
LA_UUID=REPLACE_ME
LA_ALTERID=64

# proxy-ai inner REALITY layer (dials through hk-gate)
AI_ADDRESS=REPLACE_ME
AI_PORT=17443
AI_UUID=REPLACE_ME
AI_SERVERNAME=REPLACE_ME
AI_PUBLICKEY=REPLACE_ME
AI_SHORTID=REPLACE_ME

# hk-gate outer REALITY layer
HK_ADDRESS=REPLACE_ME
HK_PORT=443
HK_UUID=REPLACE_ME
HK_SERVERNAME=REPLACE_ME
HK_PUBLICKEY=REPLACE_ME
HK_SHORTID=REPLACE_ME

# proxy-ms backup exit (manual emergency; unused by routing)
MS_ADDRESS=REPLACE_ME
MS_PORT=8744
MS_UUID=REPLACE_ME
MS_ALTERID=64
