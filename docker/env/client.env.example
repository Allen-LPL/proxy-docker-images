# New client: AI traffic over the double-layer REALITY chain; other traffic over
# the default exit. Copy to .env and fill EVERY REPLACE_ME from your secret store.
# Real endpoints, camouflage serverNames, UUIDs and keys must NEVER be committed.

# Registry namespace for the images (overrides the compose default), e.g. youruser/infra
IMAGE_REPO=youruser/infra

SOCKS_PORT=10808
HTTP_PORT=10809

# Default exit: legacy VMess (LA_*)
LA_ADDRESS=REPLACE_ME
LA_PORT=8744
LA_UUID=REPLACE_ME
LA_ALTERID=64

# proxy-ai inner REALITY layer (dials through the outer gate)
AI_ADDRESS=REPLACE_ME
AI_PORT=17443
AI_UUID=REPLACE_ME
AI_SERVERNAME=REPLACE_ME
AI_PUBLICKEY=REPLACE_ME
AI_SHORTID=REPLACE_ME

# Outer REALITY layer / gate (HK_*), used only as proxy-ai's dialer
HK_ADDRESS=REPLACE_ME
HK_PORT=443
HK_UUID=REPLACE_ME
HK_SERVERNAME=REPLACE_ME
HK_PUBLICKEY=REPLACE_ME
HK_SHORTID=REPLACE_ME

# Backup exit: legacy VMess (MS_*), manual emergency; unused by routing
MS_ADDRESS=REPLACE_ME
MS_PORT=8744
MS_UUID=REPLACE_ME
MS_ALTERID=64
